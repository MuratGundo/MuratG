<Window x:Class="UCrew.TTARCH2.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="U-CREW Guardians Tek Yama Aracı"
        Height="720" Width="1240"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17212B" Padding="20,16">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="U-CREW Guardians Tek Yama Aracı"
                               Foreground="White" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="LANDb + Font + değiştirilmiş kaynaklar → tek 0.ttarch"
                               Foreground="#B8C5D1" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock x:Name="ArchiveInfoText" DockPanel.Dock="Right"
                           Foreground="#CFE8D7" VerticalAlignment="Center"
                           Text="Arşiv açılmadı" TextAlignment="Right" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="16,16,16,10" Padding="12"
                Background="White" BorderBrush="#D6DCE2" BorderThickness="1" CornerRadius="6">
            <UniformGrid Columns="5">
                <Button x:Name="OpenArchiveButton" Content="1) TTARCH2 Aç"
                        Margin="5" Padding="12,10" Click="OpenArchive_Click" />
                <Button x:Name="ExportTxtButton" Content="2) Temiz TXT Çıkar"
                        Margin="5" Padding="12,10" Click="ExportTxt_Click" IsEnabled="False" />
                <Button x:Name="ImportTxtButton" Content="3) TXT İçe Aktar"
                        Margin="5" Padding="12,10" Click="ImportTxt_Click" IsEnabled="False" />
                <Button x:Name="AddResourceButton" Content="4) Font/Dosya Ekle"
                        Margin="5" Padding="12,10" Click="AddResource_Click" IsEnabled="False" />
                <Button x:Name="BuildPatchButton" Content="5) Tek 0.ttarch Oluştur"
                        Margin="5" Padding="12,10" Click="BuildPatch_Click" IsEnabled="False" />
            </UniformGrid>
        </Border>

        <Border Grid.Row="2" Margin="16,0,16,10" Padding="10"
                Background="White" BorderBrush="#D6DCE2" BorderThickness="1" CornerRadius="6">
            <DockPanel>
                <CheckBox x:Name="LandbOnlyCheckBox" DockPanel.Dock="Right"
                          Content="Yalnızca LANDb göster" Margin="18,0,0,0"
                          VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed" />
                <TextBlock Text="Ara:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="SearchTextBox" Height="28" MinWidth="280"
                         TextChanged="Filter_Changed" />
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Margin="16,0,16,12" Background="White"
                BorderBrush="#D6DCE2" BorderThickness="1" CornerRadius="6">
            <DataGrid x:Name="FilesGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionChanged="FilesGrid_SelectionChanged"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="75" />
                    <DataGridTextColumn Header="Dosya Adı" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Tür" Binding="{Binding Extension}" Width="100" />
                    <DataGridTextColumn Header="Boyut" Binding="{Binding Size, StringFormat={}{0:N0}}" Width="130" />
                    <DataGridTextColumn Header="Durum" Binding="{Binding State}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Background="#E8EDF2" BorderBrush="#D0D7DE" BorderThickness="1,1,1,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Hazır" VerticalAlignment="Center" />
                <ProgressBar x:Name="BusyProgressBar" Grid.Column="1" Height="16"
                             IsIndeterminate="True" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
