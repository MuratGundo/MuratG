<Window x:Class="UCrew.TTARCH2.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UCrew TTARCH2 Studio" Height="760" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Dosya">
                <MenuItem Header="_Arşiv Aç..." Click="OpenArchive_Click" />
                <Separator />
                <MenuItem Header="_JSON Raporunu Kaydet..." Click="SaveReport_Click" />
                <MenuItem Header="_Chunkları Dışarı Çıkar..." Click="DumpChunks_Click" />
                <MenuItem Header="_Seçili Chunkı Kaydet..." Click="ExportSelectedChunk_Click" />
                <MenuItem Header="_Düzenlenmiş Metni Kaydet..." Click="SaveEditedText_Click" />
                <MenuItem Header="_Metni Arşiv Kopyasına Uygula..." Click="PatchTextToCopy_Click" />
                <MenuItem Header="_LANDb Adaylarını Dışa Aktar..." Click="ExportLandbCandidates_Click" />
                <Separator />
                <MenuItem Header="Çı_kış" Click="Exit_Click" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Hazır" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Dosya:" FontWeight="SemiBold" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FileNameText" Text="-" Margin="0,0,24,6" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Boyut:" FontWeight="SemiBold" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="0" Grid.Column="3" x:Name="FileSizeText" Text="-" Margin="0,0,24,6" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Magic:" FontWeight="SemiBold" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="0" Grid.Column="5" x:Name="MagicText" Text="-" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="ECTT:" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="EcttText" Text="-" Margin="0,0,24,0" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Chunk:" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="ChunkCountText" Text="-" Margin="0,0,24,0" />
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="İmza:" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <TextBlock Grid.Row="1" Grid.Column="5" x:Name="SignatureCountText" Text="-" />
                </Grid>
            </Border>

            <TabControl Grid.Row="1" x:Name="MainTabs">
                <TabItem Header="Chunklar">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" x:Name="ChunksGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                                  SelectionChanged="ChunksGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="70" />
                                <DataGridTextColumn Header="Başlangıç (Hex)" Binding="{Binding Offset, StringFormat={}{0:X}}" Width="150" />
                                <DataGridTextColumn Header="Bitiş (Hex)" Binding="{Binding EndOffset, StringFormat={}{0:X}}" Width="150" />
                                <DataGridTextColumn Header="Boyut" Binding="{Binding Length, StringFormat={}{0:N0}}" Width="130" />
                                <DataGridTextColumn Header="Entropi" Binding="{Binding Entropy, StringFormat={}{0:0.000}}" Width="100" />
                                <DataGridTextColumn Header="Kaynak" Binding="{Binding Source}" Width="*" />
                                <DataGridTextColumn Header="Güven" Binding="{Binding Confidence, StringFormat={}{0:0.00}}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        <DockPanel Grid.Row="2" Margin="4,4,4,6">
                            <Button DockPanel.Dock="Right" Content="Seçili Chunkı Kaydet" Padding="12,5" Click="ExportSelectedChunk_Click" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Tür: " />
                            <TextBlock x:Name="SelectedChunkTypeText" VerticalAlignment="Center" Text="-" />
                        </DockPanel>
                        <TextBox Grid.Row="3" x:Name="HexPreviewText" FontFamily="Consolas" FontSize="13"
                                 IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                    </Grid>
                </TabItem>

                <TabItem Header="Metin" x:Name="TextTab">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Metni Ayrı Kaydet" Padding="12,5" Margin="0,0,6,0" Click="SaveEditedText_Click" />
                                <Button Content="Arşiv Kopyasına Uygula" Padding="12,5" Click="PatchTextToCopy_Click" />
                            </StackPanel>
                            <TextBlock x:Name="TextPreviewInfo" VerticalAlignment="Center" Text="Metin türünde bir chunk seçilmedi." />
                        </DockPanel>
                        <TextBlock Grid.Row="1" x:Name="TextByteCountInfo" Margin="0,0,0,6" Text="UTF-8 boyutu: -" />
                        <TextBox Grid.Row="2" x:Name="TextEditor" FontFamily="Consolas" FontSize="13"
                                 AcceptsReturn="True" AcceptsTab="True" TextChanged="TextEditor_TextChanged"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" IsEnabled="False" />
                    </Grid>
                </TabItem>

                <TabItem Header="LANDb">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Adayları TXT Olarak Kaydet" Padding="12,5" Click="ExportLandbCandidates_Click" />
                            <TextBlock x:Name="LandbSummaryText" VerticalAlignment="Center" Text="LANDb analizi yok." />
                        </DockPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Ara:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="LandbSearchText" Width="280" Margin="0,0,16,0" TextChanged="LandbFilter_Changed" />
                            <TextBlock Text="Minimum güven:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="LandbConfidenceBox" Width="100" SelectedIndex="1" SelectionChanged="LandbFilter_Changed">
                                <ComboBoxItem Content="0,00" Tag="0" />
                                <ComboBoxItem Content="0,50" Tag="0.5" />
                                <ComboBoxItem Content="0,65" Tag="0.65" />
                                <ComboBoxItem Content="0,80" Tag="0.8" />
                            </ComboBox>
                            <CheckBox x:Name="LandbHideShortCheck" Content="4 karakterden kısaları gizle" Margin="16,0,0,0" IsChecked="True" Checked="LandbFilter_Changed" Unchecked="LandbFilter_Changed" />
                        </StackPanel>
                        <DataGrid Grid.Row="2" x:Name="LandbCandidatesGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Offset" Binding="{Binding Offset, StringFormat={}{0:X8}}" Width="130" />
                                <DataGridTextColumn Header="Bayt" Binding="{Binding ByteLength}" Width="90" />
                                <DataGridTextColumn Header="Güven" Binding="{Binding Confidence, StringFormat={}{0:0.00}}" Width="90" />
                                <DataGridTextColumn Header="Metin" Binding="{Binding Text}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Header">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Field0004" FontWeight="SemiBold" Margin="0,0,12,8" /><TextBlock Grid.Row="0" Grid.Column="1" x:Name="Field0004Text" Text="-" />
                        <TextBlock Grid.Row="1" Text="Field0008" FontWeight="SemiBold" Margin="0,0,12,8" /><TextBlock Grid.Row="1" Grid.Column="1" x:Name="Field0008Text" Text="-" />
                        <TextBlock Grid.Row="2" Text="Field000C" FontWeight="SemiBold" Margin="0,0,12,8" /><TextBlock Grid.Row="2" Grid.Column="1" x:Name="Field000CText" Text="-" />
                        <TextBlock Grid.Row="3" Text="Offset tablo aralığı" FontWeight="SemiBold" Margin="0,0,12,8" /><TextBlock Grid.Row="3" Grid.Column="1" x:Name="OffsetTableText" Text="-" />
                    </Grid>
                </TabItem>

                <TabItem Header="İmzalar">
                    <DataGrid x:Name="SignaturesGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="180" />
                            <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="180" />
                            <DataGridTextColumn Header="Offset (Hex)" Binding="{Binding Offset, StringFormat={}{0:X}}" Width="150" />
                            <DataGridTextColumn Header="Uzunluk" Binding="{Binding Length}" Width="100" />
                            <DataGridTextColumn Header="Güven" Binding="{Binding Confidence, StringFormat={}{0:0.00}}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
