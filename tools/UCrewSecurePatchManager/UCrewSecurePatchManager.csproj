<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>UCREW_SecurePatch_Manager</AssemblyName>
    <RootNamespace>UCREW.SecurePatch.Manager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>U-CREW Güvenli Yama Yöneticisi</Product>
    <Company>U-CREW</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2024.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\server\UCrewSecurePatch\api\secure_patch_request.php" Link="Resources\secure_patch_request.php" />
    <EmbeddedResource Include="..\..\server\UCrewSecurePatch\api\secure_patch_download.php" Link="Resources\secure_patch_download.php" />
    <EmbeddedResource Include="..\..\server\UCrewSecurePatch\database\INSTALL_SCHEMA.sql" Link="Resources\INSTALL_SCHEMA.sql" />
    <EmbeddedResource Include="..\..\server\UCrewSecurePatch\INSTALL_VPS.sh" Link="Resources\INSTALL_VPS.sh" />
  </ItemGroup>
</Project>
